# Server configuration
PORT=8080

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email configuration
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Form Mailer
RECIPIENT_EMAIL=recipient@example.com

# Redirect URL after successful form submission
SUCCESS_URL=https://yoursite.com/thank-you

# Optional: shown as a "Go back" link on validation and server error pages
BACK_URL=https://yoursite.com/contact

# Optional: per-field validation rules
# Format: field:rule,rule|field:rule.arg
# Rules: required, email, min.N, max.N
VALIDATION_RULES=email:required,email|name:required,min.2
